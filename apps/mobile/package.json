{
  "name": "@j3code/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios",
    "ios:release": "EXPO_NO_GIT_STATUS=1 expo prebuild --clean --platform ios && expo run:ios --configuration Release --no-bundler",
    "config": "expo config",
    "generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-uniwind-themes.mts",
    "generate:highlights": "node scripts/generate-highlights.mts",
    "test": "vp test run --project unit --project react",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/atom-react": "catalog:",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "~58.0.14",
    "@expo/ui": "58.0.20",
    "@legendapp/list": "catalog:",
    "@pierre/diffs": "catalog:",
    "@pierre/highlights": "catalog:",
    "@react-native-menu/menu": "^2.0.0",
    "@react-navigation/elements": "2.9.45",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@t3tools/client-runtime": "workspace:*",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/mobile-highlights-native": "file:./modules/t3-highlights",
    "@t3tools/shared": "workspace:*",
    "@tabler/icons-react-native": "^3.44.0",
    "clsx": "^2.1.1",
    "diff": "8.0.3",
    "effect": "catalog:",
    "expo": "58.0.14",
    "expo-asset": "~58.0.16",
    "expo-blur": "58.0.4",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-glass-effect": "58.0.4",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-network": "~58.0.3",
    "expo-paste-input": "^0.1.15",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-symbols": "~58.0.4",
    "expo-video": "58.0.11",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "0.88.0",
    "react-native-enriched-markdown": "file:deps/react-native-enriched-markdown-1.2.0-t3.16-29ddd424.tgz",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-controller": "1.22.8",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "file:deps/react-native-screens-5.0.0-t3.48.tgz",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "tailwind-merge": "^3.5.0",
    "unified": "catalog:",
    "uniwind": "1.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@effect/vitest": "catalog:",
    "@types/mdast": "^4.0.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-preset-expo": "~58.0.17",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "enriched-markdown": {
    "enableMath": true,
    "enableVideo": false
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-keyboard-controller",
        "typescript",
        "react-native-screens",
        "react-native-enriched-markdown"
      ]
    },
    "autolinking": {
      "buildFromSource": [
        "@expo/ui",
        "expo-ui",
        "react-native-screens",
        "react-native-reanimated",
        "@react-native-menu/menu",
        "expo-video",
        "expo-network"
      ]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "DISABLE_COMMIT_PAUSING_MECHANISM": true
    }
  }
}
