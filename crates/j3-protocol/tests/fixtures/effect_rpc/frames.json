          "direction": "client->server",
          "raw": "{\"_tag\":\"Request\",\"id\":1,\"tag\":\"Lookup\",\"payload\":{\"id\":\"x1\"},\"traceId\":\"42cb50539206b58b775ac32f2fafa70c\",\"spanId\":\"18e7b23f295ba97f\",\"sampled\":true,\"headers\":[]}"
        },
        {
          "direction": "server->client",
          "raw": "{\"_tag\":\"Exit\",\"requestId\":1,\"exit\":{\"_tag\":\"Failure\",\"cause\":[{\"_tag\":\"Fail\",\"error\":{\"_tag\":\"NotFound\",\"id\":\"x1\"}}]}}"
        }
      ]
    },
