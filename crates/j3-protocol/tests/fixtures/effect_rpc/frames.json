{
  "source": "Captured from effect@4.0.5 RpcServer.layerProtocolWebsocket + RpcClient.layerProtocolSocket with RpcSerialization.layerJson over a real WebSocket (ws://127.0.0.1/ws?orchestrationProtocol=2); raw text frames logged at the client socket. Script: docs/protocol/effect-rpc.md#capture",
  "scenarios": [
    {
      "scenario": "echo",
      "frames": [
        {
          "direction": "client->server",
          "raw": "{\"_tag\":\"Request\",\"id\":0,\"tag\":\"Echo\",\"payload\":{\"text\":\"ab\",\"n\":3},\"traceId\":\"c4eefc760890fbe92a0be451d0f788a1\",\"spanId\":\"36129aee6ef293f4\",\"sampled\":true,\"headers\":[]}"
        },
        {
          "direction": "server->client",
          "raw": "{\"_tag\":\"Exit\",\"requestId\":0,\"exit\":{\"_tag\":\"Success\",\"value\":{\"text\":\"ababab\",\"len\":6}}}"
        }
      ]
    },
    {
